{
  "expo": {
    "name": "OneDelivery",
    "slug": "onedelivery",
    "version": "2.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "onedelivery",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "splash": {
      "image": "./assets/images/onedelivery-logo-wide.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.onedelivery.app",
      "buildNumber": "2",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "OneDelivery needs your location to auto-fill your delivery address and track your rider.",
        "NSLocationAlwaysUsageDescription": "OneDelivery uses your location for delivery tracking.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "OneDelivery uses your location for delivery tracking.",
        "NSCameraUsageDescription": "Used to take product and shop photos.",
        "NSPhotoLibraryUsageDescription": "Used to upload product and shop images.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "googleMapsApiKey": "$EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY"
      }
    },
    "android": {
      "package": "com.onedelivery.shop",
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "INTERNET",
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "$EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/onedelivery-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-google-signin/google-signin",
      [
        "expo-image-picker",
        {
          "photosPermission": "OneDelivery needs access to your photos to upload product and shop images.",
          "cameraPermission": "OneDelivery needs access to your camera.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "OneDelivery needs your location to fill your delivery address and track your rider.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#EC7C2C",
          "androidMode": "default",
          "androidCollapsedTitle": "OneDelivery",
          "sounds": [
            "./assets/sounds/onedelivery_notification.wav"
          ],
          "defaultChannel": "onedelivery_alerts"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/onedelivery-logo-wide.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "61051938-98d3-43e4-b2df-59212eb1be69"
      }
    },
    "owner": "titocode",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/61051938-98d3-43e4-b2df-59212eb1be69"
    }
  }
}
